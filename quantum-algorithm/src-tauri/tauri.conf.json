{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantum Algorithm",
  "version": "0.3.4",
  "identifier": "app.quantum.algorithm",
  "build": { "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Quantum Algorithm", "width": 1330, "height": 860, "minWidth": 760, "minHeight": 610, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}

